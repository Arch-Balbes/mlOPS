# Copy to .env (project root) or infra/.env for Grafana tunnel settings

ETA_PUBLIC_BASE_URL=http://localhost:8000
MLFLOW_PUBLIC_URL=http://localhost:5000
PROMETHEUS_PUBLIC_URL=http://localhost:9090
GRAFANA_PUBLIC_URL=http://localhost:3000
AIRFLOW_PUBLIC_URL=http://localhost:8080

CANARY_WEIGHT=0.33

# Grafana via tunnel4 (infra/.env) — see scripts/grafana_tunnel_env.ps1
# GRAFANA_CSRF_ORIGINS=https://YOUR-ID.tunnel4.com
# GRAFANA_ANONYMOUS_ENABLED=true
# GRAFANA_DISABLE_LOGIN=true
