# Copy to infra/.env when using tunnel4 / fxTunnel / ngrok (HTTPS public URL).
# Replace with YOUR tunnel URL from the client (no trailing path, only host).

# Do not set GRAFANA_ROOT_URL — use dynamic Host from tunnel
GRAFANA_CSRF_ORIGINS=https://ff049807-0f26-4767-9aaa-069c5d8a9e1c.tunnel4.com
GRAFANA_COOKIE_SECURE=false
GRAFANA_COOKIE_SAMESITE=lax
GRAFANA_ANONYMOUS_ENABLED=true
GRAFANA_DISABLE_LOGIN=true
